{
  "name": "neo4j-twitter-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive Neo4j Twitter analytics dashboard with AI-powered insights",
  "scripts": {
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm run dev",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:e2e": "cd frontend && npm run test:e2e",
    "test:all": "npm run test:backend && npm run test:frontend && npm run test:e2e",
    "docker:up": "cd infrastructure && docker-compose up",
    "docker:down": "cd infrastructure && docker-compose down",
    "lint:backend": "cd backend && npm run lint",
    "lint:frontend": "cd frontend && npm run lint"
  },
